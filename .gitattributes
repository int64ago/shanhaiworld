collections/*/models/**/*.usdz filter=lfs diff=lfs merge=lfs -text
collections/*/models/*.blend filter=lfs diff=lfs merge=lfs -text
collections/*/models/**/*.blend filter=lfs diff=lfs merge=lfs -text
collections/*/models/*.bin filter=lfs diff=lfs merge=lfs -text
collections/*/models/**/*.bin filter=lfs diff=lfs merge=lfs -text
collections/*/models/*.exr filter=lfs diff=lfs merge=lfs -text
collections/*/models/**/*.exr filter=lfs diff=lfs merge=lfs -text
